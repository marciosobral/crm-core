# Server
PORT=3001
# Web origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Database (Postgres)
# Neon requires ?sslmode=require at the end of the URL.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Database (PGlite, development only)
# 1 runs an in-process PGlite instead of connecting to DATABASE_URL.
DATABASE_PGLITE=0
# Directory where PGlite persists data. Comment it out to keep data in memory.
PGLITE_DATA_DIR=.pglite

# Set to production to make the seed refuse the example passwords below (the Dockerfile sets it).
# NODE_ENV=development

# Seed: passwords of the seeded accounts (at least 12 characters).
# Applied once, by the seed migration; changing them later does not update existing users.
SEED_DEMO_PASSWORD=demo-crm-1234
SEED_SELLER_PASSWORD=seller-crm-1234

# AI assistant (chat that answers CRM questions with tools, and next-step suggestion). Without a key the API starts and the assistant answers 503.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-6-luna
# Reasoning effort: none, minimal, low, medium, high, xhigh or max.
# AI_REASONING_EFFORT=low
# Cap on tokens generated per call; reasoning tokens count toward it.
# AI_MAX_OUTPUT_TOKENS=2000
