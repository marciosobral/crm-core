# Server
PORT=3001
# Web origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Database (Postgres)
# Neon requires ?sslmode=require at the end of the URL.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Database (PGlite, development only)
# 1 runs an in-process PGlite instead of connecting to DATABASE_URL.
DATABASE_PGLITE=0
# Directory where PGlite persists data. Comment it out to keep data in memory.
PGLITE_DATA_DIR=.pglite
